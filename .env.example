# Required
DATABASE_URL=postgres://user:password@host:6543/postgres   # Supabase: transaction pooler string works
APP_URL=https://your-domain.com                            # used in emails and payment callbacks
CRON_SECRET=generate-a-long-random-string                  # protects /api/cron/daily

# Email. "outbox" keeps mail in the database and shows it at /dev/mailbox (development only).
EMAIL_DRIVER=resend
RESEND_API_KEY=
EMAIL_FROM=Campora <hello@your-domain.com>

# File storage. Without these, uploads go in Postgres, which is fine for development only.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=campora

# Payments. A provider appears at checkout only when its key is set.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=      # the secret hash you set in the Flutterwave dashboard

# Seed only
SEED_PASSWORD=
